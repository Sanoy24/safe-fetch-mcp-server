{
  "name": "safe-fetch-mcp-server",
  "version": "0.6.0",
  "description": "A secure-by-default MCP server for fetching web content: SSRF, DNS-rebinding, and redirect-to-internal protection with post-resolution IP validation.",
  "mcpName": "io.github.Sanoy24/safe-fetch",
  "type": "module",
  "bin": {
    "safe-fetch-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoy24/safe-fetch-mcp-server.git"
  },
  "homepage": "https://github.com/Sanoy24/safe-fetch-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Sanoy24/safe-fetch-mcp-server/issues"
  },
  "author": "sanoy",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "pretest": "npm run build",
    "test": "vitest run --testTimeout=30000",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run check",
    "smoke": "npm run build && node scripts/smoke-pack.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fetch",
    "ssrf",
    "security",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@mozilla/readability": "^0.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "linkedom": "^0.18.13",
    "turndown": "^7.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.4",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "//": "@modelcontextprotocol/sdk is a devDependency on purpose: test/protocolEras.spec.ts uses its client to prove 2025-era clients still work. overrides.minimatch: the ESLint toolchain still pins minimatch ^10, which has an advisory (GHSA-g3hv-75wg-m249, fixed in 11.0.1); dev-only. Remove the override once eslint and typescript-eslint depend on minimatch >=11.",
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
